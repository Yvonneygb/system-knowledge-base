# AI 问答后端环境变量示例
# 复制为 .env 后填入实际值

# ===== LLM 配置（必填）=====
# OpenAI API Key（从 https://platform.openai.com/api-keys 获取）
LLM_API_KEY=sk-your-openai-api-key-here

# LLM Base URL（可选，默认 OpenAI）
# 国内可使用代理：https://open.ai-api.com.cn/v1
LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型（可选，默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# ===== 知识库配置 ======
# 从 GitHub 仓库加载知识库内容（云端模式必须）
KB_GITHUB_URL=https://github.com/Yvonneygb/system-knowledge-base

# ===== 源MD管理上传配置（可选，不配则上传仅写本地） =====
# GitHub 仓库（用于写回触发自动发布）
KB_REPO=Yvonneygb/system-knowledge-base
# 写回目标分支
KB_BRANCH=master
# 有写权限的 GitHub 个人访问令牌（PAT），仅存于环境变量，勿提交仓库
KB_GITHUB_TOKEN=ghp-your-write-access-token-here
# 上传接口共享密钥（前端上传时必须携带，防止任意改写知识库）
KB_UPLOAD_SECRET=your-upload-secret-here

# ===== 服务配置 =====
PORT=3456
NODE_ENV=production
